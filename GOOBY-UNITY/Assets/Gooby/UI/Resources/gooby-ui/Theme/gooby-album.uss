/* gooby-album.uss — sticker album and achievements (AlbumScreen, AchievementsScreen); loaded by those screens.
   Board 06 window kit: cream sheet, white cards, pastel chips; rarity strips sand / sky / sun / lilac. */

/* ---------- page rail ---------- */
.gb-alb-rail-scroll { flex-shrink: 0; margin-bottom: 10px; }
.gb-alb-rail { flex-direction: row; padding: 2px 2px 6px 2px; }
.gb-alb-chip {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 0 8px 0 0;
    padding: 0 14px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(107, 79, 58, 0.10);
    border-bottom-width: 3px;
    border-bottom-color: rgba(107, 79, 58, 0.16);
    transition-property: scale;
    transition-duration: 0.12s;
}
.gb-alb-chip:active { scale: 0.95; }
.gb-alb-chip--active { border-color: rgba(107, 79, 58, 0.28); border-bottom-color: rgba(107, 79, 58, 0.36); }
.gb-alb-chip-title { font-size: 15px; -unity-font-definition: url("../Fonts/Nunito-Bold.ttf"); color: #3B364F; white-space: nowrap; }
.gb-alb-chip-count {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
    color: #6B645C;
}
.gb-alb-chip--done > .gb-alb-chip-count { background-color: #FFD166; color: #6B4F3A; }
.gb-alb-chip-dot { position: absolute; top: -3px; right: -3px; width: 14px; height: 14px; border-radius: 7px; background-color: #FF8B8B; border-width: 2px; border-color: #FFFFFF; }

/* ---------- page head: title, progress bar, count, set reward ---------- */
.gb-alb-pagehead { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 4px 10px 4px; }
.gb-alb-pagetitle { margin-right: 14px; }
.gb-alb-pagebar { width: 180px; height: 12px; margin-right: 12px; }
.gb-alb-progress { font-size: 15px; -unity-font-definition: url("../Fonts/Nunito-SemiBold.ttf"); color: #6B645C; flex-grow: 1; }
.gb-alb-done { font-size: 16px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #6B4F3A; padding: 2px 12px; border-radius: 12px; background-color: #FFE9A8; }
.gb-alb-reward { font-size: 14px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #6B4F3A; padding: 2px 10px; border-radius: 12px; background-color: #FFF4D6; border-width: 2px; border-color: rgba(255, 209, 102, 0.7); }

/* ---------- sticker cards ---------- */
.gb-alb-grid { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; padding: 2px; }
.gb-alb-card {
    width: 150px;
    height: 188px;
    margin: 0 12px 12px 0;
    padding: 10px 8px 8px 8px;
    align-items: center;
    border-radius: 22px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: rgba(107, 79, 58, 0.08);
    border-bottom-width: 4px;
    border-bottom-color: rgba(107, 79, 58, 0.14);
    overflow: hidden;
    transition-property: scale;
    transition-duration: 0.12s;
}
.gb-alb-card:hover { scale: 1.03; }
.gb-alb-card:active { scale: 0.96; }
.gb-alb-card--locked { background-color: #FBF4EA; }
.gb-alb-strip { position: absolute; left: 0; right: 0; top: 0; height: 7px; }
.gb-alb-art { width: 124px; height: 124px; margin-top: 4px; -unity-background-scale-mode: scale-to-fit; justify-content: center; align-items: center; }
.gb-alb-q { font-size: 44px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: rgba(107, 79, 58, 0.45); }
.gb-alb-name { margin-top: 6px; font-size: 14px; -unity-font-definition: url("../Fonts/Nunito-Bold.ttf"); color: #3B364F; -unity-text-align: middle-center; white-space: normal; }
.gb-alb-card--locked > .gb-alb-name { color: #A39B93; }
.gb-alb-new { position: absolute; top: 12px; right: 8px; padding: 1px 8px; border-radius: 10px; background-color: #FF8B8B; color: #FFFFFF; font-size: 12px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); rotate: 8deg; }

/* ---------- collections (AlbumScreen.Collections): four set cards with a tile per entry ---------- */
.gb-alb-chip-icon { width: 22px; height: 22px; margin-right: 6px; }
.gb-alb-grid--sets { flex-direction: column; flex-wrap: nowrap; }
.gb-alb-set {
    margin: 0 4px 12px 2px;
    padding: 12px 16px 12px 14px;
    border-radius: 24px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: rgba(107, 79, 58, 0.08);
    border-bottom-width: 4px;
    border-bottom-color: rgba(107, 79, 58, 0.14);
}
.gb-alb-set--ready { background-color: #FFFBEA; border-color: rgba(255, 209, 102, 0.85); border-bottom-color: rgba(242, 179, 61, 0.9); }
.gb-alb-set--claimed { background-color: #F4FBF6; border-color: rgba(127, 207, 155, 0.5); }
.gb-alb-set-head { flex-direction: row; align-items: center; }
.gb-alb-set-badge { width: 46px; height: 46px; border-radius: 16px; flex-shrink: 0; justify-content: center; align-items: center; background-color: #EAF4FF; }
.gb-alb-set-badge > .gb-icon { width: 30px; height: 30px; }
.gb-alb-set-texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 12px; }
.gb-alb-set-title { font-size: 18px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #3B364F; }
.gb-alb-set-hint { font-size: 13px; -unity-font-definition: url("../Fonts/Nunito-SemiBold.ttf"); color: #6B645C; white-space: normal; }
.gb-alb-set-count { flex-shrink: 0; margin-left: 10px; padding: 2px 12px; border-radius: 12px; background-color: #F3EBE1; font-size: 15px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #6B4F3A; }
.gb-alb-set--ready .gb-alb-set-count { background-color: #FFD166; }
.gb-alb-set-tiles { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.gb-alb-slot { width: 104px; margin: 0 4px 6px 0; align-items: center; }
.gb-alb-slot-tile { width: 62px; height: 62px; border-radius: 18px; justify-content: center; align-items: center; }
.gb-alb-slot-tile--missing { background-color: #F1E9DE; border-width: 2px; border-color: rgba(107, 79, 58, 0.10); }
.gb-alb-slot-icon { width: 40px; height: 40px; }
.gb-alb-slot-q { font-size: 28px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: rgba(107, 79, 58, 0.4); }
.gb-alb-slot-n { position: absolute; top: -6px; right: -8px; padding: 0 6px; border-radius: 9px; background-color: #FF8B8B; color: #FFFFFF; font-size: 12px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); }
.gb-alb-slot-name, .gb-alb-slot-name--missing { margin-top: 4px; font-size: 12px; -unity-font-definition: url("../Fonts/Nunito-Bold.ttf"); color: #3B364F; -unity-text-align: upper-center; white-space: normal; }
.gb-alb-slot-name--missing { color: #A39B93; }
.gb-alb-set-foot { flex-direction: row; align-items: center; margin-top: 4px; }
.gb-alb-set-reward { flex-direction: row; align-items: center; flex-shrink: 1; padding: 4px 12px 4px 6px; border-radius: 16px; background-color: #FFF4D6; }
.gb-alb-set-thumb { width: 40px; height: 40px; }
.gb-alb-set-reward-text { margin-left: 6px; font-size: 13px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #6B4F3A; white-space: normal; flex-shrink: 1; }
.gb-alb-set-claim { flex-shrink: 0; margin-left: 12px; height: 44px; min-width: 190px; }

/* ---------- sticker detail ---------- */
.gb-alb-detail {
    position: absolute;
    left: 50%; top: 50%;
    translate: -50% -50%;
    width: 440px;
    padding: 20px 26px 22px 26px;
    align-items: center;
    border-radius: 30px;
}
.gb-alb-detail-art { width: 230px; height: 230px; -unity-background-scale-mode: scale-to-fit; }
.gb-alb-detail-name { margin-top: 6px; -unity-text-align: middle-center; white-space: normal; }
.gb-alb-detail-rarity { margin-top: 6px; padding: 2px 14px; border-radius: 12px; font-size: 13px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #3B364F; }
.gb-alb-detail-label { margin-top: 12px; color: #6B645C; }
.gb-alb-detail-text { margin-top: 8px; -unity-text-align: middle-center; white-space: normal; color: #3B364F; }
.gb-alb-detail-ok { margin-top: 16px; min-width: 200px; height: 54px; }

/* ---------- achievements ---------- */
.gb-ach-list { padding: 2px; }
.gb-ach-row {
    flex-direction: row;
    align-items: center;
    min-height: 74px;
    margin-bottom: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 20px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: rgba(107, 79, 58, 0.08);
    border-bottom-width: 4px;
    border-bottom-color: rgba(107, 79, 58, 0.12);
}
.gb-ach-row--done { background-color: #FFFBF0; border-color: rgba(255, 209, 102, 0.55); border-bottom-color: rgba(255, 209, 102, 0.85); }
.gb-ach-medal { width: 52px; height: 52px; border-radius: 26px; margin-right: 14px; flex-shrink: 0; justify-content: center; align-items: center; background-color: #EFE6DA; }
.gb-ach-row--done .gb-ach-medal { background-color: #FFD166; }
.gb-ach-medal > .gb-icon { width: 30px; height: 30px; }
.gb-ach-row--locked .gb-ach-medal > .gb-icon { -unity-background-image-tint-color: rgba(107, 79, 58, 0.45); }
.gb-ach-texts { flex-grow: 1; flex-shrink: 1; }
.gb-ach-name { font-size: 17px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #3B364F; white-space: normal; }
.gb-ach-desc { margin-top: 2px; font-size: 14px; -unity-font-definition: url("../Fonts/Nunito-SemiBold.ttf"); color: #6B645C; white-space: normal; }
.gb-ach-progress { flex-direction: row; align-items: center; margin-top: 6px; }
.gb-ach-bar { width: 200px; height: 10px; margin-right: 10px; }
.gb-ach-count { font-size: 13px; -unity-font-definition: url("../Fonts/Nunito-Bold.ttf"); color: #A39B93; }
.gb-ach-coins { flex-shrink: 0; margin-left: 12px; padding: 4px 12px; border-radius: 14px; background-color: #FFF4D6; border-width: 2px; border-color: rgba(255, 209, 102, 0.7); font-size: 15px; -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf"); color: #6B4F3A; }
.gb-ach-row--done .gb-ach-coins { background-color: #DFF3E5; border-color: rgba(127, 207, 155, 0.8); }
